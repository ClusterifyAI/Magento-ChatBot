<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="clusterify_chatbot_sync_process_queue"
             instance="ClusterifyAI\ChatBot\Cron\ProcessQueue"
             method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
