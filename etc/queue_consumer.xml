<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/consumer.xsd">
    <consumer name="clusterify.chatbot.sync.cms"
              queue="clusterify.chatbot.sync.cms"
              connection="amqp"
              handler="ClusterifyAI\ChatBot\Model\Queue\Consumer\CmsConsumer::process"/>
    <consumer name="clusterify.chatbot.sync.category"
              queue="clusterify.chatbot.sync.category"
              connection="amqp"
              handler="ClusterifyAI\ChatBot\Model\Queue\Consumer\CategoryConsumer::process"/>
    <consumer name="clusterify.chatbot.sync.product"
              queue="clusterify.chatbot.sync.product"
              connection="amqp"
              handler="ClusterifyAI\ChatBot\Model\Queue\Consumer\ProductConsumer::process"/>
</config>
