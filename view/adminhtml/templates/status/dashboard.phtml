<script type="text/javascript">
require(['jquery'], function ($) {
    'use strict';

    $('#btn-process-queue').on('click', function () {
        var $btn = $(this);
        var $feedback = $('#queue-process-feedback');
        var originalHtml = $btn.html();

        $btn.prop('disabled', true).text('<?= $escaper->escapeJs(__('Processing tasks...')) ?>');
        $feedback.hide();

        $.ajax({
            url: '<?= $escaper->escapeUrl($block->getUrl('clusterify_chatbot/status/processQueue')) ?>',
            type: 'POST',
            dataType: 'json',
            data: { form_key: window.FORM_KEY },
            success: function (response) {
                $btn.prop('disabled', false).html(originalHtml);

                if (response.success) {
                    $feedback.css({'background': '#dcfce7', 'color': '#166534', 'border': '1px solid #bbf7d0'})
                        .text(response.message).fadeIn();

                    if (response.queues && response.queues.length) {
                        $.each(response.queues, function (i, q) {
                            var $row = $('tr[data-queue="' + q.queue_name + '"]');
                            if ($row.length) {
                                var badge = q.message_count > 0
                                    ? '<span style="display: inline-block; padding: 2px 10px; background: #e0f2fe; color: #0369a1; border-radius: 12px; font-weight: 700; font-size: 11px;">' + q.message_count + ' <?= $escaper->escapeJs(__('Pending')) ?></span>'
                                    : '<span style="display: inline-block; padding: 2px 10px; background: #dcfce7; color: #166534; border-radius: 12px; font-weight: 600; font-size: 11px;"><?= $escaper->escapeJs(__('0 Pending')) ?></span>';
                                $row.find('.col-pending').html(badge);
                            }
                        });
                    }
                } else {
                    $feedback.css({'background': '#fee2e2', 'color': '#991b1b', 'border': '1px solid #fecaca'})
                        .text(response.message || '<?= $escaper->escapeJs(__('Error processing tasks.')) ?>').fadeIn();
                }
            },
            error: function () {
                $btn.prop('disabled', false).html(originalHtml);
                $feedback.css({'background': '#fee2e2', 'color': '#991b1b', 'border': '1px solid #fecaca'})
                    .text('<?= $escaper->escapeJs(__('Network error occurred while contacting the server.')) ?>').fadeIn();
            }
        });
    });
});
</script>
