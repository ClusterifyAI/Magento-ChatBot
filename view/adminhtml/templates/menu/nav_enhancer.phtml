<script type="text/javascript">
require(['jquery'], function ($) {
    'use strict';

    function injectPlanBanner() {
        var $submenu = $('.item-clusterify-root .submenu');
        if ($submenu.length) {
            // Set submenu panel title to full 'ChatBot & Assistant'
            var $title = $submenu.find('.submenu-title');
            if ($title.length) {
                $title.text('ChatBot & Assistant');
            }

            // Inject plan status banner if not yet injected
            if (!$('#clusterify-nav-plan-banner').length) {
                var $banner = $('#clusterify-nav-plan-template').children().clone();
                if ($title.length) {
                    $title.after($banner);
                } else {
                    $submenu.prepend($banner);
                }
            }
        }
    }

    function enhanceExternalLinks() {
        var externalLinks = {
            'item-menu-platform-dashboard': 'https://dashboard.clusterify.ai',
            'item-menu-platform-billing': 'https://dashboard.clusterify.ai/billing',
            'item-menu-platform-chatbot': 'https://dashboard.clusterify.ai/chatbot',
            'item-menu-platform-api-keys': 'https://dashboard.clusterify.ai/api-key'
        };

        $.each(externalLinks, function (itemClass, targetUrl) {
            var $link = $('.item-clusterify-root .' + itemClass + ' > a');
            if ($link.length && !$link.hasClass('clusterify-enhanced')) {
                $link.addClass('clusterify-enhanced')
                    .attr('href', targetUrl)
                    .attr('target', '_blank')
                    .attr('rel', 'noopener noreferrer');
            }
        });
    }

    function handleConfigGroupNavigation() {
        if (!window.location.pathname.includes('clusterify_chatbot')) {
            return;
        }

        var match = window.location.pathname.match(/\/group\/([a-zA-Z0-9_]+)/);
        var groupId = match ? match[1] : null;

        if (!groupId && window.location.hash) {
            groupId = window.location.hash.replace('#', '').replace('clusterify_chatbot_', '').replace('-head', '');
        }

        if (groupId) {
            var targetId = 'clusterify_chatbot_' + groupId;
            var $head = $('#' + targetId + '-head');
            var $target = $head.length ? $head : $('#' + targetId);

            if ($target.length) {
                // Ensure section is expanded if collapsed
                if ($head.length && !$head.hasClass('open') && typeof Fieldset !== 'undefined') {
                    Fieldset.toggleCollapse(targetId);
                }

                // Smooth scroll directly to the section
                setTimeout(function () {
                    $('html, body').animate({
                        scrollTop: Math.max(0, $target.offset().top - 80)
                    }, 400);

                    // Add brief focus highlight
                    $target.css({'transition': 'background 0.4s ease-out', 'background': '#e0f2fe'});
                    setTimeout(function () {
                        $target.css('background', '');
                    }, 2000);
                }, 300);
            }
        }
    }

    $(function () {
        injectPlanBanner();
        enhanceExternalLinks();
        handleConfigGroupNavigation();

        // Also observe menu interactions if lazily loaded
        $(document).on('mouseenter click', '.item-clusterify-root, #nav', function () {
            injectPlanBanner();
            enhanceExternalLinks();
        });
    });
});
</script>
